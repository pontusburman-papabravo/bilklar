  "stages": [
    {
      "key": "foundation",
      "title": "Grund",
      "description": "Fordonskännedom och grundmanövrering i nästan trafikfri miljö"
    },
    {
      "key": "controlled_traffic",
      "title": "Lugn trafik",
      "description": "Bostadsområde och lätt trafik med grundläggande observation"
    },
    {
      "key": "mixed_traffic",
      "title": "Blandad trafik",
      "description": "Korsningar, signaler, stad, måttlig komplexitet"
    },
    {
      "key": "complex_traffic",
      "title": "Komplex trafik",
      "description": "Rondell, landsväg, motorväg, svårare förhållanden"
    },
    {
      "key": "independent_readiness",
      "title": "Självständighetsnära",
      "description": "Självständig körning mot mål och examensnära helhet"
    }
  ],
  "contextDifficulty": {
    "model": "ordinal_per_dimension",
    "combinationRule": "context_tier = max(dimension_levels); increase at most one dimension between passes after independent",
    "dimensions": [
      {
        "dimension": "traffic",
        "sequence": [
          "light",
          "moderate",
          "heavy"
        ]
      },
      {
        "dimension": "environment",
        "sequence": [
          "residential",
          "urban",
          "rural",
          "highway"
        ]
      },
      {
        "dimension": "light",
        "sequence": [
          "daylight",
          "dusk_dawn",
          "night"
        ]
      },
      {
        "dimension": "weather",
        "sequence": [
          "dry",
          "rain",
          "snow_ice"
        ]
      }
    ]
  },
  "observationProgressionRules": {
    "needs_help": "Repeat same skill in same or easier context",
    "with_support": "Repeat same skill in same context",
    "independent": "Increase one context dimension for same skill, or introduce adjacent skill at same/easier context"
  },
  "firstDriveStartingPoints": [
    {
      "skillKey": "car_control_pre_drive_check",
