# Copy to deploy/.env on the VPS. Never commit real values.
# On the live server, append missing keys — do not rotate POSTGRES_PASSWORD
# or SESSION_SECRET (that would lock out the database and admin cookies).
# scripts/vps-deploy-revision.sh refuses empty POSTGRES_PASSWORD,
# SESSION_SECRET, RESEND_API_KEY, and RESEND_WEBHOOK_SECRET.
POSTGRES_PASSWORD=
SESSION_SECRET=
APP_BASE_URL=https://korpasset.se
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Optional. Default: Körpasset <support@korpasset.se>
EMAIL_FROM=Körpasset <support@korpasset.se>
